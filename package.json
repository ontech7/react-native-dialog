{
  "name": "@ontech7/react-native-dialog",
  "version": "1.4.0",
  "description": "Simple and lightweight dialog component for React Native, structure similar to shadcn/ui, with dimezis background blur. Compatible with Android & iOS.",
  "main": "build/commonjs/index.js",
  "module": "build/module/index.js",
  "types": "build/module/index.d.ts",
  "sideEffects": false,
  "files": [
    "build"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsc -p tsconfig.build.cjs.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest",
    "prepublishOnly": "yarn typecheck && yarn test && yarn build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ontech7/react-native-dialog.git"
  },
  "keywords": [
    "react",
    "native",
    "portal",
    "dialog",
    "shadcn",
    "expo",
    "android",
    "ios",
    "component"
  ],
  "author": "Andrea Losavio (github.com/ontech7)",
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@testing-library/react-native": "^14",
    "@types/jest": "^30",
    "@types/react": "~19.2.10",
    "jest": "^30",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "test-renderer": "~1.2.0",
    "typescript": "~6.0.3"
  },
  "homepage": "https://github.com/ontech7/react-native-dialog",
  "bugs": {
    "url": "https://github.com/ontech7/react-native-dialog/issues"
  },
  "readmeFilename": "README.md",
  "packageManager": "yarn@1.22.22"
}
